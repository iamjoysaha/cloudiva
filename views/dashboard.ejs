      }

      function downloadFile(id) {
        const f = S.files.find((x) => x.id === id);
        if (!f?.url) return toast("No download URL");
        const a = document.createElement("a");
        a.href = f.url;
        a.download = f.displayName || f.name;
        a.target = "_blank";
        a.rel = "noopener";
        document.body.append(a);
        a.click();
        a.remove();
        toast("Downloading…");
      }

      async function restoreFile(id) {
        try {
          await api("/file/" + encodeURIComponent(id), {
