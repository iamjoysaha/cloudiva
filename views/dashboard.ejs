            S.folderId = null;
            S.path = [];
          }
          await refresh();
        } catch (err) {
          toast(err.message || "Could not move to trash");
        }
      }

      async function softDeleteFile(id) {
        try {
          await api("/file/" + encodeURIComponent(id) + "?soft=1", {
            method: "DELETE",
          });
