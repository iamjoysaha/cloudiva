      async function hardDeleteFile(id) {
        if (!confirm("Delete this file forever? This cannot be undone.")) return;
        try {
          await api("/file/" + encodeURIComponent(id) + "?soft=0", {
            method: "DELETE",
          });
          toast("File permanently deleted");
          await refresh();
        } catch (err) {
          toast(err.message || "Could not delete file");
