<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>Dashboard | Cloudiva</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #f4f5f9;
        --card: #ffffff;
        --ink: #0f1633;
        --mut: #5d6585;
        --line: #e2e5f0;
        --acc: #4f5bff;
        --accd: #3d48e0;
        --soft: #eef0ff;
        --acc2: #ff6b4a;
        --lime: #c6f432;
        --success: #16a34a;
        --r: 14px;
        --sh:
          0 1px 2px rgba(15, 22, 51, 0.04),
          0 8px 24px -10px rgba(15, 22, 51, 0.1);
        --sh-lg: 0 20px 50px -20px rgba(15, 22, 51, 0.25);
        --preview-bg: rgba(15, 22, 51, 0.55);
        --preview-header: rgba(255, 255, 255, 0.92);
        --preview-ink: #0f1633;
        --preview-mut: #5d6585;
        --code-bg: #f8f9fc;
        --code-border: #e2e5f0;
        box-sizing: border-box;
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #0f0f17;
          --card: #181825;
          --ink: #f1efe8;
          --mut: #9a98ad;
          --line: #2a2a3d;
          --soft: #23274d;
          --preview-bg: rgba(8, 8, 14, 0.72);
          --preview-header: rgba(24, 24, 37, 0.92);
          --preview-ink: #f1efe8;
          --preview-mut: #9a98ad;
          --code-bg: #12121c;
          --code-border: #2a2a3d;
        }
      }

      :root[data-theme="dark"] {
        --bg: #0f0f17;
        --card: #181825;
        --ink: #f1efe8;
        --mut: #9a98ad;
        --line: #2a2a3d;
        --soft: #23274d;
        --preview-bg: rgba(8, 8, 14, 0.72);
        --preview-header: rgba(24, 24, 37, 0.92);
        --preview-ink: #f1efe8;
        --preview-mut: #9a98ad;
        --code-bg: #12121c;
        --code-border: #2a2a3d;
      }

      :root[data-theme="light"] {
        --preview-bg: rgba(15, 22, 51, 0.48);
        --preview-header: rgba(255, 255, 255, 0.94);
        --preview-ink: #0f1633;
        --preview-mut: #5d6585;
        --code-bg: #f8f9fc;
        --code-border: #e2e5f0;
      }

      * {
        box-sizing: border-box;
        margin: 0;
      }

      html {
        height: 100%;
        scroll-padding-top: env(safe-area-inset-top, 0px);
      }

      body {
        height: 100%;
        background: var(--bg);
        color: var(--ink);
        font:
          15px/1.45 Inter,
          "Segoe UI",
          system-ui,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      button,
      input,
      select {
        font: inherit;
        color: inherit;
      }

      button {
        cursor: pointer;
        border: 0;
        background: none;
        transition:
          background 0.15s,
          border-color 0.15s,
          box-shadow 0.15s,
          transform 0.12s;
      }

      .hide {
        display: none !important;
      }

      /* ===== App shell ===== */
      #app {
        height: 100%;
        display: grid;
        grid-template-columns: 256px 1fr;
        padding: 0;
        gap: 0;
      }

      aside {
        background: var(--card);
        border-right: 1px solid var(--line);
        padding: 20px 14px;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 20px;
        letter-spacing: -0.5px;
        padding: 4px 8px 16px;
      }

      .logo i {
        width: 28px;
        height: 28px;
        border-radius: 9px 9px 9px 2px;
        background: linear-gradient(135deg, var(--acc), #7b85ff);
        display: block;
        box-shadow: 0 4px 12px rgba(79, 91, 255, 0.35);
      }

      .newb {
        background: var(--acc);
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
        margin: 4px 0 14px;
        padding: 12px;
        display: flex;
        gap: 8px;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(79, 91, 255, 0.25);
      }

      .newb:hover {
        background: var(--accd);
        transform: translateY(-1px);
      }

      .nav {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 11px 14px;
        border-radius: 10px;
        color: var(--mut);
        text-align: left;
        width: 100%;
        font-weight: 500;
      }

      .nav:hover {
        background: var(--soft);
        color: var(--ink);
      }

      .nav.on {
        background: var(--soft);
        color: var(--acc);
        font-weight: 600;
      }

      .meter {
        margin-top: auto;
        background: var(--bg);
        border-radius: 14px;
        padding: 16px;
        border: 1px solid var(--line);
      }

      .meter .usage-label {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 2px;
      }

      .bar {
        height: 7px;
        border-radius: 9px;
        background: var(--line);
        overflow: hidden;
        margin: 10px 0 12px;
      }

      .bar b {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--acc), #7b85ff);
        width: 0;
        transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        border-radius: 9px;
      }

      .upgrade-btn {
        width: 100%;
        padding: 10px 12px;
        border-radius: 9px;
        background: var(--acc);
        color: #fff;
        font-weight: 600;
        font-size: 13.5px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }

      .upgrade-btn:hover {
        background: var(--accd);
      }

      main {
        background: var(--bg);
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
      }

      .top {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 12px 24px;
        background: var(--card);
        border-bottom: 1px solid var(--line);
        position: relative;
      }

      .search {
        flex: 1;
        max-width: 520px;
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 11px;
        padding: 0 16px;
        transition:
          border-color 0.15s,
          background 0.15s;
      }

      .search:focus-within {
        background: var(--card);
        border-color: var(--acc);
        box-shadow: 0 0 0 3px rgba(79, 91, 255, 0.12);
      }

      .search input {
        border: 0;
        background: none;
        outline: 0;
        padding: 11px 0;
        width: 100%;
      }

      .ib {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: var(--card);
        border: 1px solid var(--line);
        display: grid;
        place-items: center;
      }

      .ib:hover {
        background: var(--soft);
      }

      .av {
        background: var(--acc);
        color: #fff;
        border-color: var(--acc);
        font-weight: 700;
        position: relative;
      }

      .account-menu {
        position: absolute;
        top: 56px;
        right: 24px;
        width: 260px;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        box-shadow: var(--sh-lg);
        z-index: 25;
        padding: 14px;
        display: none;
      }

      .account-menu.open {
        display: block;
      }

      .account-menu .name {
        font-weight: 700;
        font-size: 15px;
      }

      .account-menu .email {
        color: var(--mut);
        font-size: 13px;
        margin-top: 2px;
        margin-bottom: 12px;
        word-break: break-all;
      }

      .account-menu button {
        width: 100%;
        text-align: left;
        padding: 10px 12px;
        border-radius: 9px;
        font-weight: 500;
        color: var(--ink);
      }

      .account-menu button:hover {
        background: var(--soft);
      }

      .account-menu .logout {
        color: var(--acc2);
        margin-top: 4px;
      }

      .content {
        flex: 1;
        overflow: auto;
        padding: 4px 24px 40px;
      }

      .content.drag {
        outline: 3px dashed var(--acc);
        outline-offset: -12px;
      }

      h3 {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--mut);
        margin: 22px 0 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .files.grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(176px, 1fr));
        gap: 14px;
      }

      .f {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 12px;
        position: relative;
        box-shadow: var(--sh);
        cursor: pointer;
        transition:
          border-color 0.15s,
          transform 0.15s,
          box-shadow 0.15s,
          opacity 0.15s;
      }

      .f:hover {
        border-color: var(--acc);
        box-shadow: 0 8px 24px -10px rgba(79, 91, 255, 0.2);
      }

      .f.dragging {
        opacity: 0.45;
        transform: scale(0.97);
      }

      .f.drop-target {
        border-color: var(--acc);
        box-shadow: 0 0 0 3px rgba(79, 91, 255, 0.25);
        background: var(--soft);
      }

      .thumb {
        height: 92px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        font-size: 34px;
        margin-bottom: 10px;
        overflow: hidden;
        background: #f0f2f8;
      }

      :root[data-theme="dark"] .thumb {
        background: #222233;
      }

      .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 11px;
      }

      .fn {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .fm {
        color: var(--mut);
        font-size: 12px;
      }

      .acts {
        position: absolute;
        top: 8px;
        right: 8px;
        display: flex;
        gap: 2px;
        opacity: 0;
        transition: 0.15s;
      }

      .f:hover .acts {
        opacity: 1;
      }

      .acts button {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--card);
        border: 1px solid var(--line);
        font-size: 13px;
      }

      .acts button:hover {
        background: var(--soft);
      }

      .files.list {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .files.list .f {
        display: grid;
        grid-template-columns: 44px 1fr 90px 110px;
        align-items: center;
        gap: 12px;
        padding: 8px 12px;
      }

      .files.list .thumb {
        height: 40px;
        width: 40px;
        margin: 0;
        font-size: 20px;
        border-radius: 10px;
      }

      .files.list .acts {
        position: static;
        opacity: 1;
        grid-column: auto;
      }

      .empty {
        text-align: center;
        color: var(--mut);
        padding: 72px 20px;
      }

      .empty .big {
        font-size: 52px;
        margin-bottom: 14px;
        opacity: 0.9;
      }

      .empty p {
        font-size: 15px;
      }

      .crumb {
        display: flex;
        gap: 6px;
        align-items: center;
        color: var(--mut);
        margin: 16px 0 0;
        flex-wrap: wrap;
        font-size: 14px;
      }

      .crumb a {
        cursor: pointer;
      }

      .crumb a:hover {
        color: var(--acc);
      }

      .crumb .drop-root.drop-target,
      .crumb .drop-crumb.drop-target {
        color: var(--acc);
        font-weight: 600;
        outline: 2px dashed var(--acc);
        outline-offset: 3px;
        border-radius: 6px;
        padding: 2px 6px;
      }

      /* Modal base */
      .modal {
        position: fixed;
        inset: 0;
        background: rgba(15, 22, 51, 0.5);
        backdrop-filter: blur(4px);
        display: grid;
        place-items: center;
        z-index: 40;
        padding: 20px;
      }

      .mb {
        background: var(--card);
        padding: 28px;
        border-radius: 18px;
        width: min(400px, 92vw);
        box-shadow: var(--sh-lg);
      }

      .mb h2 {
        margin-bottom: 16px;
        font-size: 20px;
        font-weight: 700;
      }

      .fld {
        margin-bottom: 14px;
      }

      .fld label {
        display: block;
        font-size: 13px;
        color: var(--mut);
        margin-bottom: 6px;
        font-weight: 500;
      }

      .fld input,
      .fld select {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--card);
        outline: 0;
        transition:
          border-color 0.15s,
          box-shadow 0.15s;
      }

      .fld input:focus {
        border-color: var(--acc);
        box-shadow: 0 0 0 3px rgba(79, 91, 255, 0.16);
      }

      .row {
        display: flex;
        gap: 8px;
        margin-top: 16px;
        justify-content: flex-end;
      }

      .row button {
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
      }

      .pri {
        background: var(--acc);
        color: #fff;
      }

      .pri:hover {
        background: var(--accd);
      }

      .ghost {
        border: 1px solid var(--line);
        background: var(--card);
      }

      .ghost:hover {
        background: var(--soft);
      }

      .danger {
        background: var(--acc2);
        color: #fff;
      }

      .danger:hover {
        filter: brightness(1.08);
      }

      .toast {
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--ink);
        color: var(--bg);
        padding: 12px 20px;
        border-radius: 12px;
        z-index: 50;
        box-shadow: var(--sh-lg);
        font-weight: 500;
        font-size: 14px;
      }

      /* ===== Preview overlay (theme-aware + transparent) ===== */
      .pv {
        position: fixed;
        inset: 0;
        z-index: 35;
        background: var(--preview-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
      }

      .pvh {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 20px;
        color: var(--preview-ink);
        background: var(--preview-header);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(16px);
      }

      .pvh .ib {
        background: transparent;
        color: var(--preview-ink);
        border-color: var(--line);
      }

      .pvh .ib:hover {
        background: var(--soft);
      }

      .pvh .fm {
        color: var(--preview-mut);
      }

      .btn2 {
        padding: 10px 16px;
        border-radius: 9px;
        font-weight: 600;
        color: var(--preview-ink);
        border: 1px solid var(--line);
        background: transparent;
      }

      .btn2:hover {
        background: var(--soft);
      }

      .pvb {
        flex: 1;
        overflow: auto;
        display: grid;
        place-items: center;
        padding: 24px;
        min-height: 0;
      }

      .pvimg {
        max-width: 100%;
        max-height: calc(100vh - 120px);
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
      }

      .pvfr {
        width: min(960px, 100%);
        height: calc(100vh - 140px);
        border: 0;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
      }

      /* Video / Audio players */
      .media-wrap {
        width: min(960px, 100%);
        max-height: calc(100vh - 140px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .media-wrap video {
        max-width: 100%;
        max-height: calc(100vh - 180px);
        border-radius: 12px;
        background: #000;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
      }

      .media-wrap audio {
        width: min(480px, 100%);
      }

      /* Code / text viewer */
      .code-viewer {
        width: min(920px, 100%);
        max-height: calc(100vh - 140px);
        background: var(--code-bg);
        border: 1px solid var(--code-border);
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
      }

      .code-meta {
        padding: 10px 16px;
        font-size: 12px;
        color: var(--preview-mut);
        border-bottom: 1px solid var(--code-border);
        background: var(--card);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .code-body {
        overflow: auto;
        flex: 1;
        margin: 0;
        padding: 18px 20px;
        font-family:
          "SF Mono", "Fira Code", "Cascadia Code", ui-monospace, Menlo,
          Consolas, monospace;
        font-size: 13.5px;
        line-height: 1.55;
        color: var(--preview-ink);
        white-space: pre-wrap;
        word-break: break-word;
        tab-size: 2;
      }

      .sheet-wrap {
        background: var(--card);
        color: var(--ink);
        border-radius: 12px;
        max-width: 100%;
        max-height: calc(100vh - 140px);
        overflow: auto;
        box-shadow: 0 16px 50px rgba(0, 0, 0, 0.2);
        border: 1px solid var(--line);
      }

      .sheet-wrap table {
        border-collapse: collapse;
        min-width: 100%;
        font-size: 13px;
      }

      .sheet-wrap th,
      .sheet-wrap td {
        border: 1px solid var(--line);
        padding: 8px 12px;
        text-align: left;
        white-space: nowrap;
        max-width: 280px;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .sheet-wrap th {
        background: var(--bg);
        font-weight: 600;
        position: sticky;
        top: 0;
        z-index: 1;
      }

      .sheet-wrap tr:nth-child(even) td {
        background: color-mix(in srgb, var(--bg) 60%, transparent);
      }

      .sheet-meta {
        padding: 10px 14px;
        font-size: 12px;
        color: var(--mut);
        border-bottom: 1px solid var(--line);
        background: var(--bg);
      }

      .preview-fallback {
        text-align: center;
        color: var(--preview-ink);
        max-width: 420px;
      }

      .preview-fallback .icon {
        font-size: 64px;
        margin-bottom: 16px;
      }

      .preview-fallback p {
        color: var(--preview-mut);
        margin-top: 8px;
        line-height: 1.5;
      }

      .menu {
        display: none;
      }

      @media (max-width: 800px) {
        #app {
          grid-template-columns: 1fr;
        }
        aside {
          position: fixed;
          inset: 0 auto 0 0;
          width: 270px;
          z-index: 20;
          transform: translateX(-100%);
          transition: 0.22s cubic-bezier(0.22, 1, 0.36, 1);
        }
        aside.open {
          transform: none;
        }
        .menu {
          display: grid;
        }
        .files.list .f {
          grid-template-columns: 40px 1fr 80px;
        }
        .files.list .f .fm:nth-of-type(2) {
          display: none;
        }
        .account-menu {
          right: 12px;
        }
      }

      .spinner {
        width: 28px;
        height: 28px;
        border: 3px solid var(--line);
        border-top-color: var(--acc);
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        margin: 40px auto;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .drop-hint {
        border: 2px dashed var(--line);
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        color: var(--mut);
        margin-top: 16px;
        background: color-mix(in srgb, var(--card) 60%, transparent);
      }

      /* ===== Pricing ===== */
      .pricing-overlay {
        position: fixed;
        inset: 0;
        z-index: 45;
        background: var(--bg);
        overflow: auto;
        display: flex;
        flex-direction: column;
      }

      .pricing-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 28px;
        background: var(--card);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 2;
      }

      .pricing-header h1 {
        font-size: 18px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .pricing-body {
        max-width: 1080px;
        margin: 0 auto;
        padding: 40px 24px 80px;
        width: 100%;
      }

      .pricing-intro {
        text-align: center;
        margin-bottom: 36px;
      }

      .pricing-intro h2 {
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.6px;
        margin-bottom: 10px;
      }

      .pricing-intro p {
        color: var(--mut);
        font-size: 16px;
        max-width: 480px;
        margin: 0 auto;
      }

      .billing-toggle {
        display: inline-flex;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px;
        margin: 28px auto 0;
        gap: 2px;
      }

      .billing-toggle button {
        padding: 9px 22px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 14px;
        color: var(--mut);
      }

      .billing-toggle button.active {
        background: var(--acc);
        color: #fff;
        box-shadow: 0 2px 8px rgba(79, 91, 255, 0.3);
      }

      .save-badge {
        background: var(--lime);
        color: #0f1633;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 999px;
        margin-left: 6px;
        vertical-align: middle;
      }

      .plans {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 36px;
      }

      @media (max-width: 900px) {
        .plans {
          grid-template-columns: 1fr;
          max-width: 400px;
          margin-left: auto;
          margin-right: auto;
        }
      }

      .plan {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        position: relative;
        transition:
          border-color 0.2s,
          box-shadow 0.2s,
          transform 0.2s;
      }

      .plan:hover {
        border-color: color-mix(in srgb, var(--acc) 40%, var(--line));
        box-shadow: var(--sh);
      }

      .plan.featured {
        border-color: var(--acc);
        box-shadow:
          0 0 0 1px var(--acc),
          var(--sh-lg);
        transform: scale(1.02);
      }

      .plan .badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--acc);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 999px;
        white-space: nowrap;
      }

      .plan .plan-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--mut);
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 8px;
      }

      .plan .price {
        font-size: 36px;
        font-weight: 800;
        letter-spacing: -1px;
        line-height: 1.1;
      }

      .plan .price span {
        font-size: 15px;
        font-weight: 500;
        color: var(--mut);
        letter-spacing: 0;
      }

      .plan .price-note {
        font-size: 13px;
        color: var(--mut);
        margin-top: 4px;
        margin-bottom: 20px;
        min-height: 18px;
      }

      .plan ul {
        list-style: none;
        margin: 0 0 28px;
        flex: 1;
      }

      .plan li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        padding: 7px 0;
        font-size: 14px;
        color: var(--ink);
      }

      .plan li::before {
        content: "✓";
        color: var(--success);
        font-weight: 700;
        flex-shrink: 0;
      }

      .plan .cta {
        width: 100%;
        padding: 13px;
        border-radius: 11px;
        font-weight: 600;
        font-size: 15px;
        text-align: center;
      }

      .plan .cta.primary {
        background: var(--acc);
        color: #fff;
      }

      .plan .cta.primary:hover {
        background: var(--accd);
      }

      .plan .cta.secondary {
        background: var(--soft);
        color: var(--acc);
        border: 1px solid transparent;
      }

      .plan .cta.secondary:hover {
        border-color: var(--acc);
      }

      .plan .cta.current {
        background: var(--bg);
        color: var(--mut);
        cursor: default;
      }

      .pricing-footer {
        text-align: center;
        margin-top: 48px;
        color: var(--mut);
        font-size: 13px;
      }

      .pricing-footer a {
        color: var(--acc);
        text-decoration: none;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <section id="app">
      <aside id="side">
        <div class="logo"><i></i>Cloudiva</div>
        <button class="newb" onclick="openNewModal()">＋ New</button>
        <button class="nav on" data-v="drive" onclick="setView('drive')">
          🗂 My Drive
        </button>
        <button class="nav" data-v="trash" onclick="setView('trash')">
          🗑 Trash
        </button>
        <div class="meter">
          <div class="usage-label"><b id="su">—</b></div>
          <div style="color: var(--mut); font-size: 13px" id="slimit">
            of — used
          </div>
          <div class="bar"><b id="sbar" style="width: 2%"></b></div>
          <button class="upgrade-btn" onclick="openPricing()">
            ⬆ Get more space
          </button>
        </div>
      </aside>

      <main>
        <div class="top">
          <button
            class="ib menu"
            onclick="document.getElementById('side').classList.toggle('open')"
          >
            ☰
          </button>
          <div class="search">
            🔍
            <input
              id="q"
              placeholder="Search files and folders"
              oninput="render()"
            />
          </div>
          <button class="ib" id="vt" title="Toggle view" onclick="toggleView()">
            ▦
          </button>
          <button class="ib" title="Theme" onclick="toggleTheme()">🌓</button>
          <button
            class="ib av"
            id="avt"
            title="Account"
            onclick="toggleAccountMenu()"
          >
            —
          </button>

          <div class="account-menu" id="accountMenu">
            <div class="name" id="accName">—</div>
            <div class="email" id="accEmail">—</div>
            <button onclick="logout()">Log out</button>
          </div>
        </div>
        <div class="content" id="ct">
          <div class="spinner"></div>
        </div>
      </main>

      <input
        type="file"
        id="up"
        multiple
        class="hide"
        onchange="handleUpload(this.files)"
      />
    </section>

    <div id="md"></div>
    <div id="pv"></div>
    <div id="pricing"></div>

    <script>
      const API = ""; // same-origin
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => document.querySelectorAll(s);

      const ICON = {
        folder: "📁",
        img: "🖼️",
        doc: "📄",
        pdf: "📕",
        sheet: "📊",
        vid: "🎬",
        audio: "🎵",
        zip: "🗜️",
        code: "💻",
        file: "📎",
      };
      const TINT = {
        folder: "#fff1c9",
        img: "#dff5e6",
        doc: "#dbe7ff",
        pdf: "#ffdede",
        sheet: "#d7f5ef",
        vid: "#eadcff",
        audio: "#ffe8f0",
        zip: "#ececec",
        code: "#e8f0ff",
        file: "#ececec",
      };

      // Allowed text/code extensions for in-browser preview
      const TEXT_EXTS = new Set([
        ".c",
        ".h",
        ".cpp",
        ".cc",
        ".cxx",
        ".hpp",
        ".hh",
        ".hxx",
        ".py",
        ".pyw",
        ".pyi",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".java",
        ".cs",
        ".go",
        ".rs",
        ".rb",
        ".php",
        ".swift",
        ".kt",
        ".kts",
        ".scala",
        ".dart",
        ".lua",
        ".pl",
        ".pm",
        ".hs",
        ".ex",
        ".exs",
        ".clj",
        ".fs",
        ".fsx",
        ".ml",
        ".mli",
        ".html",
        ".htm",
        ".css",
        ".scss",
        ".sass",
        ".less",
        ".vue",
        ".svelte",
        ".sh",
        ".bash",
        ".zsh",
        ".bat",
        ".cmd",
        ".ps1",
        ".sql",
        ".json",
        ".xml",
        ".yaml",
        ".yml",
        ".toml",
        ".ini",
        ".conf",
        ".env",
        ".md",
        ".mdx",
        ".txt",
        ".ipynb",
        ".r",
        ".jl",
        ".m",
      ]);

      // ---------- State ----------
      const S = {
        view: "drive",
        folderId: null,
        folderTree: [],
        trashedFolders: [],
        trashedFiles: [],
        files: [],
        grid: true,
        loading: false,
        path: [],
        drag: null,
        profile: null,
        billing: "yearly",
      };

      // ---------- Persistence ----------
      function loadPrefs() {
        try {
          const prefs = JSON.parse(
            localStorage.getItem("cloudiva_prefs") || "{}",
          );
          if (prefs.view === "drive" || prefs.view === "trash")
            S.view = prefs.view;
          if (typeof prefs.grid === "boolean") S.grid = prefs.grid;
          if (prefs.theme === "light" || prefs.theme === "dark") {
            document.documentElement.dataset.theme = prefs.theme;
          }
        } catch (_) {}
      }

      function savePrefs() {
        const theme =
          document.documentElement.dataset.theme ||
          (getComputedStyle(document.documentElement)
            .getPropertyValue("--bg")
            .trim() === "#0f0f17"
            ? "dark"
            : "light");
        localStorage.setItem(
          "cloudiva_prefs",
          JSON.stringify({
            view: S.view,
            grid: S.grid,
            theme,
          }),
        );
      }

      // ---------- Helpers ----------
      function toast(msg) {
        const d = document.createElement("div");
        d.className = "toast";
        d.textContent = msg;
        document.body.append(d);
        setTimeout(() => d.remove(), 2400);
      }

      function fmtSize(bytes) {
        if (bytes == null || bytes === 0) return "0 B";
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + " KB";
        if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + " MB";
        return (bytes / 1073741824).toFixed(2) + " GB";
      }

      function timeAgo(iso) {
        if (!iso) return "";
        const d = new Date(iso);
        const diff = (Date.now() - d) / 1000;
        if (diff < 60) return "Just now";
        if (diff < 3600) return Math.floor(diff / 60) + " min ago";
        if (diff < 86400) return Math.floor(diff / 3600) + "h ago";
        if (diff < 172800) return "Yesterday";
        if (diff < 604800) return Math.floor(diff / 86400) + " days ago";
        return d.toLocaleDateString();
      }

      function getExt(name) {
        if (!name) return "";
        const i = name.lastIndexOf(".");
        return i >= 0 ? name.slice(i).toLowerCase() : "";
      }

      function kindFromMime(mime, name) {
        const ext = getExt(name);
        if (mime) {
          if (mime.startsWith("image/")) return "img";
          if (mime === "application/pdf") return "pdf";
          if (mime.startsWith("video/")) return "vid";
          if (mime.startsWith("audio/")) return "audio";
          if (
            mime.includes("sheet") ||
            mime.includes("excel") ||
            mime.includes("csv") ||
            mime === "text/csv"
          )
            return "sheet";
          if (
            mime.includes("zip") ||
            mime.includes("compressed") ||
            mime.includes("tar") ||
            mime.includes("gzip") ||
            mime.includes("rar") ||
            mime.includes("7z")
          )
            return "zip";
          if (
            mime.includes("word") ||
            mime.includes("document") ||
            mime.includes("msword") ||
            mime.includes("presentation") ||
            mime.includes("powerpoint")
          )
            return "doc";
        }
        if (ext) {
          if (/^\.(png|jpe?g|gif|webp|svg)$/.test(ext)) return "img";
          if (ext === ".pdf") return "pdf";
          if (/^\.(mp4|webm|ogg|mov)$/.test(ext)) return "vid";
          if (/^\.(mp3|wav|ogg|m4a|aac|flac)$/.test(ext)) return "audio";
          if (/^\.(xlsx?|csv)$/.test(ext)) return "sheet";
          if (/^\.(zip|rar|7z|tar|gz|bz2)$/.test(ext)) return "zip";
          if (TEXT_EXTS.has(ext)) return "code";
          if (/^\.(docx?|pptx?|odt|rtf)$/.test(ext)) return "doc";
        }
        return "file";
      }

      function isTextPreviewable(f) {
        if (f.t === "code") return true;
        const ext = getExt(f.displayName || f.name);
        if (TEXT_EXTS.has(ext)) return true;
        const mime = (f.mimeType || "").toLowerCase();
        return (
          mime.startsWith("text/") ||
          mime.includes("json") ||
          mime.includes("xml") ||
          mime.includes("javascript") ||
          mime.includes("typescript")
        );
      }

      function esc(t) {
        return String(t || "").replace(
          /[<>&"]/g,
          (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" })[c],
        );
      }

      function getInitials(first, last) {
        const a = (first || "").trim().charAt(0);
        const b = (last || "").trim().charAt(0);
        return (a + b).toUpperCase() || "U";
      }

      async function api(path, opts = {}) {
        const res = await fetch(API + path, {
          credentials: "include",
          ...opts,
          headers: {
            ...(opts.body && !(opts.body instanceof FormData)
              ? { "Content-Type": "application/json" }
              : {}),
            ...opts.headers,
          },
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) {
          throw new Error(json.message || res.statusText || "Request failed");
        }
        return json;
      }

      // ---------- Profile ----------
      async function loadProfile() {
        try {
          const res = await api("/user/profile");
          S.profile = res.data || null;
          applyProfile();
        } catch (err) {
          console.error("Profile load failed:", err);
        }
      }

      function applyProfile() {
        const p = S.profile;
        if (!p) return;
        $("#avt").textContent = getInitials(p.firstName, p.lastName);
        $("#accName").textContent =
          [p.firstName, p.lastName].filter(Boolean).join(" ") || "User";
        $("#accEmail").textContent = p.email || "";
        updateStorageMeter();
      }

      function updateStorageMeter() {
        const p = S.profile;
        if (!p) {
          $("#su").textContent = "—";
          $("#slimit").textContent = "of — used";
          $("#sbar").style.width = "2%";
          return;
        }
        const used = Number(p.storageUsed) || 0;
        const limit = Number(p.storageLimit) || 1;
        $("#su").textContent = fmtSize(used);
        $("#slimit").textContent = "of " + fmtSize(limit) + " used";
        const pct = Math.min(100, (used / limit) * 100);
        $("#sbar").style.width = Math.max(2, pct) + "%";
      }

      function toggleAccountMenu() {
        $("#accountMenu").classList.toggle("open");
      }

      document.addEventListener("click", (e) => {
        const menu = $("#accountMenu");
        const avt = $("#avt");
        if (
          menu.classList.contains("open") &&
          !menu.contains(e.target) &&
          e.target !== avt
        ) {
          menu.classList.remove("open");
        }
      });

      async function logout() {
        try {
          await api("/user/logout", { method: "POST" });
        } catch (err) {
          console.error(err);
        }
        window.location.href = "/login";
      }

      // ---------- Data ----------
      async function loadFolders() {
        const res = await api("/folder");
        S.folderTree = res.data || [];
        return S.folderTree;
      }

      async function loadTrashedFolders() {
        const res = await api("/folder/trashed");
        S.trashedFolders =
          (res.data && res.data.trashed_folders) || res.data || [];
        return S.trashedFolders;
      }

      async function loadTrashedFiles() {
        const res = await api("/file/trashed");
        S.trashedFiles = (res.data?.trashed_files || res.data || []).map(
          (f) => ({
            ...f,
            t: kindFromMime(f.mimeType, f.originalName || f.name),
            displayName: f.originalName || f.name,
          }),
        );
        return S.trashedFiles;
      }

      async function loadFiles(folderId) {
        const query =
          folderId != null
            ? "/file?folderId=" + encodeURIComponent(folderId)
            : "/file";
        const res = await api(query);
        S.files = (res.data || []).map((f) => ({
          ...f,
          t: kindFromMime(f.mimeType, f.originalName || f.name),
          displayName: f.originalName || f.name,
        }));
        return S.files;
      }

      function findFolderInTree(id, tree = S.folderTree) {
        for (const f of tree) {
          if (f.id === id) return f;
          if (f.subfolders?.length) {
            const found = findFolderInTree(id, f.subfolders);
            if (found) return found;
          }
        }
        return null;
      }

      function getCurrentFolders() {
        if (!S.folderId) {
          return S.folderTree.filter((f) => !f.isTrashed);
        }
        const current = findFolderInTree(S.folderId);
        return (current?.subfolders || []).filter((f) => !f.isTrashed);
      }

      function buildPath(folderId) {
        if (!folderId) return [];
        const path = [];
        let cur = findFolderInTree(folderId);
        while (cur) {
          path.unshift({ id: cur.id, name: cur.name });
          if (!cur.parentId) break;
          cur = findFolderInTree(cur.parentId);
        }
        return path;
      }

      // ---------- Navigation ----------
      function setView(v) {
        S.view = v;
        S.folderId = null;
        S.path = [];
        $$(".nav").forEach((b) => b.classList.toggle("on", b.dataset.v === v));
        $("#side").classList.remove("open");
        savePrefs();
        refresh();
      }

      function openFolder(id) {
        if (S.view === "trash") return;
        if (S.drag) return;
        S.folderId = id;
        S.path = buildPath(id);
        S.view = "drive";
        $$(".nav").forEach((b) =>
          b.classList.toggle("on", b.dataset.v === "drive"),
        );
        savePrefs();
        refresh();
      }

      function toggleView() {
        S.grid = !S.grid;
        $("#vt").textContent = S.grid ? "▦" : "☰";
        savePrefs();
        render();
      }

      function toggleTheme() {
        const r = document.documentElement;
        const isDark =
          r.dataset.theme === "dark" ||
          (!r.dataset.theme &&
            getComputedStyle(r).getPropertyValue("--bg").trim() === "#0f0f17");
        r.dataset.theme = isDark ? "light" : "dark";
        savePrefs();
      }

      // ---------- Drag & Drop ----------
      function onDragStart(e, type, id) {
        if (S.view === "trash") {
          e.preventDefault();
          return;
        }
        S.drag = { type, id };
        e.dataTransfer.effectAllowed = "move";
        e.dataTransfer.setData("text/plain", id);
        e.currentTarget.classList.add("dragging");
      }

      function onDragEnd(e) {
        e.currentTarget.classList.remove("dragging");
        $$(".drop-target").forEach((el) => el.classList.remove("drop-target"));
        S.drag = null;
      }

      function onDragOverFolder(e) {
        if (!S.drag) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = "move";
        const card = e.currentTarget;
        if (!card.classList.contains("drop-target")) {
          $$(".drop-target").forEach((el) =>
            el.classList.remove("drop-target"),
          );
          card.classList.add("drop-target");
        }
      }

      function onDragLeaveFolder(e) {
        if (!e.currentTarget.contains(e.relatedTarget)) {
          e.currentTarget.classList.remove("drop-target");
        }
      }

      async function onDropOnFolder(e, targetFolderId) {
        e.preventDefault();
        e.stopPropagation();
        e.currentTarget.classList.remove("drop-target");
        if (!S.drag) return;
        const { type, id } = S.drag;
        S.drag = null;
        if (type === "folder" && id === targetFolderId) {
          toast("Cannot move a folder into itself");
          return;
        }
        try {
          if (type === "folder") {
            await api("/folder/" + encodeURIComponent(id), {
              method: "PATCH",
              body: JSON.stringify({
                operation: "move",
                parentId: targetFolderId,
              }),
            });
            toast("Folder moved");
          } else if (type === "file") {
            await api("/file/" + encodeURIComponent(id), {
              method: "PATCH",
              body: JSON.stringify({
                operation: "move",
                folderId: targetFolderId,
              }),
            });
            toast("File moved");
          }
          await refresh();
        } catch (err) {
          toast(err.message || "Move failed");
        }
      }

      function onDragOverRoot(e) {
        if (!S.drag) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = "move";
        e.currentTarget.classList.add("drop-target");
      }

      function onDragLeaveRoot(e) {
        e.currentTarget.classList.remove("drop-target");
      }

      async function onDropOnRoot(e) {
        e.preventDefault();
        e.currentTarget.classList.remove("drop-target");
        if (!S.drag) return;
        const { type, id } = S.drag;
        S.drag = null;
        try {
          if (type === "folder") {
            await api("/folder/" + encodeURIComponent(id), {
              method: "PATCH",
              body: JSON.stringify({
                operation: "move",
                parentId: null,
              }),
            });
            toast("Folder moved to My Drive");
          } else if (type === "file") {
            await api("/file/" + encodeURIComponent(id), {
              method: "PATCH",
              body: JSON.stringify({
                operation: "move",
                folderId: null,
              }),
            });
            toast("File moved to My Drive");
          }
          await refresh();
        } catch (err) {
          toast(err.message || "Move failed");
        }
      }

      // ---------- Cards ----------
      function cardFolder(f, isTrash = false) {
        const actions = isTrash
          ? `<button title="Restore" onclick="restoreFolder('${f.id}')">↩</button>
           <button title="Delete forever" onclick="hardDeleteFolder('${f.id}')">✕</button>`
          : `<button title="Rename" onclick="showRenameFolder('${f.id}','${esc(f.name)}')">✎</button>
           <button title="Move to trash" onclick="softDeleteFolder('${f.id}')">🗑</button>`;

        const dragAttrs = isTrash
          ? ""
          : `
        draggable="true"
        ondragstart="onDragStart(event,'folder','${f.id}')"
        ondragend="onDragEnd(event)"
        ondragover="onDragOverFolder(event)"
        ondragleave="onDragLeaveFolder(event)"
        ondrop="onDropOnFolder(event,'${f.id}')"
      `;

        return `
        <div class="f" data-id="${f.id}" data-type="folder"
          ${isTrash ? "" : `onclick="openFolder('${f.id}')"`}
          ${dragAttrs}>
          <div class="thumb" style="background:${TINT.folder}">${ICON.folder}</div>
          <div>
            <div class="fn">${esc(f.name)}</div>
            <div class="fm">${isTrash ? "Trashed " + timeAgo(f.trashedAt) : timeAgo(f.createdAt)}</div>
          </div>
          <div class="acts" onclick="event.stopPropagation()">
            ${actions}
          </div>
        </div>`;
      }

      function cardFile(f, isTrash = false) {
        const isImg = f.t === "img" && f.url;
        const thumb = isImg
          ? `<img src="${f.url}" alt="" loading="lazy" onerror="this.parentNode.innerHTML='${ICON.img}'">`
          : ICON[f.t] || ICON.file;

        const actions = isTrash
          ? `<button title="Restore" onclick="restoreFile('${f.id}')">↩</button>
            <button title="Delete forever" onclick="hardDeleteFile('${f.id}')">✕</button>`
          : `<button title="Rename" onclick="showRenameFile('${f.id}')">✎</button>
            <button title="Download" onclick="downloadFile('${f.id}')">⬇</button>
            <button title="Move to trash" onclick="softDeleteFile('${f.id}')">🗑</button>`;

        return `
          <div class="f" data-id="${f.id}" data-type="file"
            ${isTrash ? "" : `onclick="previewFile('${f.id}')"`}
            ${
              isTrash
                ? ""
                : `draggable="true"
              ondragstart="onDragStart(event,'file','${f.id}')"
              ondragend="onDragEnd(event)"`
            }>
            <div class="thumb" style="background:${TINT[f.t] || TINT.file}">${thumb}</div>
            <div>
              <div class="fn">${esc(f.displayName)}</div>
              <div class="fm">${isTrash ? "Trashed " + timeAgo(f.trashedAt) : timeAgo(f.createdAt)}</div>
            </div>
            <div class="fm">${fmtSize(f.size)}</div>
            <div class="acts" onclick="event.stopPropagation()">
              ${actions}
            </div>
          </div>`;
      }

      // ---------- Render ----------
      function render() {
        const q = ($("#q").value || "").toLowerCase().trim();
        const ct = $("#ct");
        let html = "";

        if (S.view === "drive") {
          html += `<div class="crumb">
          <a class="drop-root"
             onclick="S.folderId=null;S.path=[];refresh()"
             ondragover="onDragOverRoot(event)"
             ondragleave="onDragLeaveRoot(event)"
             ondrop="onDropOnRoot(event)">My Drive</a>`;

          S.path.forEach((p, i) => {
            const isLast = i === S.path.length - 1;
            if (isLast) {
              html += ` › <b style="color:var(--ink)">${esc(p.name)}</b>`;
            } else {
              html += ` › <a class="drop-crumb"
                             onclick="openFolder('${p.id}')"
                             ondragover="onDragOverFolder(event)"
                             ondragleave="onDragLeaveFolder(event)"
                             ondrop="onDropOnFolder(event,'${p.id}')">${esc(p.name)}</a>`;
            }
          });
          html += `</div>`;
        }

        const titles = {
          drive: S.folderId ? "Files in folder" : "My Drive",
          trash: "Trash",
        };
        html += `<h3>${titles[S.view] || "Files"}
        ${S.view === "drive" ? `<span><button onclick="openNewModal()" style="color:var(--acc);font-weight:600">＋ New</button></span>` : ""}
        ${S.view === "trash" ? `<span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--mut)">Items stay in trash until permanently deleted</span>` : ""}
      </h3>`;

        let folders = [];
        let files = [];

        if (S.view === "drive") {
          folders = getCurrentFolders();
          files = S.files.filter((f) => !f.isTrashed);
        } else if (S.view === "trash") {
          folders = S.trashedFolders || [];
          files = S.trashedFiles || [];
        }

        if (q) {
          folders = folders.filter((f) => f.name.toLowerCase().includes(q));
          files = files.filter((f) =>
            (f.displayName || f.name || "").toLowerCase().includes(q),
          );
        }

        const all = [
          ...folders.map((f) => ({ type: "folder", data: f })),
          ...files.map((f) => ({ type: "file", data: f })),
        ];

        if (S.loading) {
          ct.innerHTML = html + '<div class="spinner"></div>';
          return;
        }

        if (all.length === 0) {
          html += `
          <div class="empty">
            <div class="big">${S.view === "trash" ? "🗑" : "📂"}</div>
            <p>${S.view === "trash" ? "Trash is empty." : "Nothing here yet."}</p>
            ${S.view !== "trash" ? `<p style="margin-top:10px;opacity:.85">Drop files anywhere or click <b>＋ New</b></p>` : ""}
          </div>
          ${S.view !== "trash" ? `<div class="drop-hint">Drag & drop files here to upload<br><small style="opacity:.7">You can also drag folders/files onto other folders or breadcrumb items to move them</small></div>` : ""}`;
        } else {
          html += `<div class="files ${S.grid ? "grid" : "list"}">`;
          all.forEach((item) => {
            if (item.type === "folder") {
              html += cardFolder(item.data, S.view === "trash");
            } else {
              html += cardFile(item.data, S.view === "trash");
            }
          });
          html += `</div>`;
        }

        ct.innerHTML = html;
      }

      // ---------- Actions ----------
      async function refresh() {
        S.loading = true;
        render();
        try {
          if (S.view === "trash") {
            await Promise.all([loadTrashedFolders(), loadTrashedFiles()]);
            S.files = [];
          } else {
            await loadFolders();
            await loadFiles(S.folderId);
          }
        } catch (err) {
          toast(err.message || "Failed to load");
          console.error(err);
        } finally {
          S.loading = false;
          render();
        }
      }

