      function downloadFile(id) {
        const f =
          S.files.find((x) => x.id === id) ||
          (S.trashedFiles || []).find((x) => x.id === id);
        if (!f?.url) return toast("No download URL");
        const a = document.createElement("a");
        a.href = f.url;
        a.download = f.displayName || f.name;
