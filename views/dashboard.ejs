      // ---------- Preview ----------
      function loadSheetJS() {
        return new Promise((resolve, reject) => {
          if (window.XLSX) return resolve(window.XLSX);
          const s = document.createElement("script");
          s.src =
            "https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js";
          s.onload = () => resolve(window.XLSX);
          s.onerror = () =>
            reject(new Error("Failed to load spreadsheet library"));
          document.head.appendChild(s);
        });
      }

      function renderSheetTable(rows, meta = "") {
        if (!rows || !rows.length) {
          return `<div class="sheet-wrap"><div class="sheet-meta">Empty sheet</div></div>`;
        }
        const header = rows[0];
        const bodyRows = rows.slice(1);
        let html = `<div class="sheet-wrap">`;
        if (meta) html += `<div class="sheet-meta">${esc(meta)}</div>`;
        html += `<table><thead><tr>`;
        header.forEach((cell) => {
          html += `<th>${esc(cell == null ? "" : cell)}</th>`;
        });
        html += `</tr></thead><tbody>`;
        bodyRows.forEach((row) => {
          html += `<tr>`;
          header.forEach((_, i) => {
            const val = row[i] == null ? "" : row[i];
            html += `<td title="${esc(val)}">${esc(val)}</td>`;
          });
          html += `</tr>`;
        });
        html += `</tbody></table></div>`;
        return html;
      }

      function parseCSV(text) {
        const lines = text
          .replace(/\r\n/g, "\n")
          .replace(/\r/g, "\n")
          .split("\n")
          .filter((l) => l.trim() !== "");
        return lines.map((line) => {
          const cells = [];
          let cur = "";
          let inQuotes = false;
          for (let i = 0; i < line.length; i++) {
            const ch = line[i];
            if (ch === '"') {
              if (inQuotes && line[i + 1] === '"') {
                cur += '"';
                i++;
              } else inQuotes = !inQuotes;
            } else if (ch === "," && !inQuotes) {
              cells.push(cur);
              cur = "";
            } else {
              cur += ch;
            }
          }
          cells.push(cur);
          return cells;
        });
      }

      async function previewSheet(f, container) {
        container.innerHTML = `<div style="color:#fff;text-align:center"><div class="spinner" style="border-top-color:#fff;margin:0 auto 12px"></div>Loading spreadsheet…</div>`;
        try {
          if (!f.url) throw new Error("No file URL available");

          const name = (f.displayName || f.name || "").toLowerCase();
          const isCSV =
            name.endsWith(".csv") || (f.mimeType && f.mimeType.includes("csv"));

          if (isCSV) {
            const res = await fetch(f.url);
            if (!res.ok) throw new Error("Failed to fetch file");
            const text = await res.text();
            const rows = parseCSV(text).slice(0, 201);
            const meta =
              rows.length > 1
                ? `Showing ${Math.min(rows.length - 1, 200)} of many rows`
                : "CSV preview";
            container.innerHTML = renderSheetTable(rows, meta);
            return;
          }

          const XLSX = await loadSheetJS();
          const res = await fetch(f.url);
          if (!res.ok) throw new Error("Failed to fetch file");
          const buf = await res.arrayBuffer();
          const wb = XLSX.read(buf, { type: "array" });
          const sheetName = wb.SheetNames[0];
          const ws = wb.Sheets[sheetName];
          const rows = XLSX.utils
            .sheet_to_json(ws, { header: 1, defval: "" })
            .slice(0, 201);
          const meta = `Sheet: ${sheetName}${wb.SheetNames.length > 1 ? ` (${wb.SheetNames.length} sheets)` : ""} · showing first ${Math.min(rows.length, 200)} rows`;
          container.innerHTML = renderSheetTable(rows, meta);
        } catch (err) {
          console.error(err);
          container.innerHTML = `
          <div style="text-align:center;color:#fff">
            <div style="font-size:64px;margin-bottom:16px">${ICON.sheet}</div>
            <b>${esc(f.displayName)}</b>
            <p style="color:#aab0d0;margin-top:8px">Could not preview this spreadsheet.<br>${esc(err.message || "Unknown error")}</p>
            <button class="pri" style="margin-top:20px" onclick="downloadFile('${f.id}')">⬇ Download</button>
          </div>`;
        }
      }

      function previewFile(id) {
        const f = S.files.find((x) => x.id === id);
        if (!f) return;

        let body = "";
        let asyncSheet = false;

        if (f.t === "img" && f.url) {
          body = `<img src="${f.url}" class="pvimg" alt="">`;
        } else if (f.t === "pdf" && f.url) {
          body = `<iframe src="${f.url}" class="pvfr"></iframe>`;
        } else if (f.t === "vid" && f.url) {
          body = `<video src="${f.url}" controls class="pvimg" style="max-height:80vh"></video>`;
        } else if (f.t === "sheet" && f.url) {
          body = `<div id="sheet-preview" style="width:100%;height:100%;display:grid;place-items:center"></div>`;
          asyncSheet = true;
        } else {
          body = `
          <div style="text-align:center;color:#fff">
            <div style="font-size:64px;margin-bottom:16px">${ICON[f.t] || ICON.file}</div>
            <b>${esc(f.displayName)}</b>
            <p style="color:#aab0d0;margin-top:8px">No in-browser preview for this type.<br>Download to open.</p>
            <button class="pri" style="margin-top:20px" onclick="downloadFile('${f.id}')">⬇ Download</button>
          </div>`;
        }

        $("#pv").innerHTML = `
        <div class="pv">
          <div class="pvh">
            <button class="ib" onclick="closePreview()">✕</button>
            <span style="font-size:22px">${ICON[f.t] || ICON.file}</span>
            <div style="min-width:0">
              <b>${esc(f.displayName)}</b>
              <div class="fm">${fmtSize(f.size)} · ${timeAgo(f.createdAt)}</div>
            </div>
            <span style="flex:1"></span>
            <button class="btn2" onclick="downloadFile('${f.id}')">⬇ Download</button>
          </div>
          <div class="pvb">${body}</div>
        </div>`;

        if (asyncSheet) {
          const container = document.getElementById("sheet-preview");
          if (container) previewSheet(f, container);
        }
      }

      function closePreview() {
        $("#pv").innerHTML = "";
      }

      // ---------- Drag & drop (upload) ----------
      const ct = $("#ct");
      ["dragover", "dragenter"].forEach((ev) => {
        ct.addEventListener(ev, (e) => {
          if (e.dataTransfer && [...e.dataTransfer.types].includes("Files")) {
            e.preventDefault();
            ct.classList.add("drag");
          }
        });
      });
      ["dragleave", "drop"].forEach((ev) => {
        ct.addEventListener(ev, (e) => {
          e.preventDefault();
          ct.classList.remove("drag");
        });
      });
      ct.addEventListener("drop", (e) => {
        if (e.dataTransfer?.files?.length) {
          handleUpload(e.dataTransfer.files);
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closePreview();
          closeModal();
        }
      });

      // ---------- Init ----------
      (async function init() {
        await refresh();
      })();
    </script>
  </body>
</html>