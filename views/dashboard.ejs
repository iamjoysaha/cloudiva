            ? "Current plan"
            : p.featured
              ? "Upgrade to Pro"
              : "Get Business";

          cards += `
            <div class="plan ${p.featured ? "featured" : ""}">
              ${p.featured ? `<div class="badge">Most popular</div>` : ""}
              <div class="plan-name">${p.name}</div>
              <div class="price">
                $${price === 0 ? "0" : price.toFixed(price % 1 === 0 ? 0 : 2)}
                <span>${price === 0 ? "" : "/mo"}</span>
              </div>
              <div class="price-note">${priceNote}</div>
              <ul>
                ${p.features.map((f) => `<li>${f}</li>`).join("")}
              </ul>
              <button class="cta ${ctaClass}" onclick="selectPlan('${p.id}')"${
                p.current ? " disabled" : ""
              }>
                ${ctaLabel}
              </button>
            </div>`;
        });

        $("#pricing").innerHTML = `
          <div class="pricing-overlay">
            <div class="pricing-header">
              <h1><i style="width:22px;height:22px;border-radius:7px 7px 7px 2px;background:var(--acc);display:inline-block;vertical-align:middle;margin-right:4px"></i> Cloudiva</h1>
              <button class="ib" onclick="closePricing()" title="Close">✕</button>
            </div>
            <div class="pricing-body">
              <div class="pricing-intro">
                <h2>Choose the plan that’s right for you</h2>
                <p>More space, better collaboration, and advanced controls when you need them.</p>
                <div class="billing-toggle">
                  <button class="${!isYearly ? "active" : ""}" onclick="setBilling('monthly')">Monthly</button>
                  <button class="${isYearly ? "active" : ""}" onclick="setBilling('yearly')">
                    Yearly <span class="save-badge">Save 20%</span>
                  </button>
                </div>
              </div>
              <div class="plans">${cards}</div>
              <div class="pricing-footer">
                All plans include SSL encryption and 99.9% uptime SLA.<br>
                Need a custom enterprise plan? <a href="mailto:sales@cloudiva.app">Contact sales</a>
              </div>
            </div>
          </div>`;
      }

      // ---------- Drag & drop upload ----------
      const ct = $("#ct");
      ["dragover", "dragenter"].forEach((ev) => {
        ct.addEventListener(ev, (e) => {
          if (e.dataTransfer && [...e.dataTransfer.types].includes("Files")) {
            e.preventDefault();
            ct.classList.add("drag");
          }
        });
      });
      ["dragleave", "drop"].forEach((ev) => {
        ct.addEventListener(ev, (e) => {
          e.preventDefault();
          ct.classList.remove("drag");
        });
      });
      ct.addEventListener("drop", (e) => {
        if (e.dataTransfer?.files?.length) {
          handleUpload(e.dataTransfer.files);
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closePreview();
          closeModal();
          closePricing();
          $("#accountMenu").classList.remove("open");
        }
      });

      // ---------- Init ----------
      (async function init() {
        loadPrefs();
        $$(".nav").forEach((b) =>
          b.classList.toggle("on", b.dataset.v === S.view),
        );
        $("#vt").textContent = S.grid ? "▦" : "☰";
        await loadProfile();
        await refresh();
      })();
    </script>
  </body>
</html>
