      async function createFolder() {
        const name = ($("#mi")?.value || "").trim();
        if (!name) return toast("Enter a folder name");
        try {
          await api("/folder", {
            method: "POST",
            body: JSON.stringify({
              name,
              parentId: S.folderId || null,
            }),
          });
          closeModal();
          toast("Folder created");
          await refresh();
        } catch (err) {
          toast(err.message || "Could not create folder");
        }
      }

      async function renameFolder(id) {
        const name = ($("#mi")?.value || "").trim();
        if (!name) return toast("Enter a folder name");
        try {
          await api("/folder/" + encodeURIComponent(id), {
            method: "PATCH",
            body: JSON.stringify({
              operation: "rename",
              name,
            }),
          });
          closeModal();
          toast("Folder renamed");
          await refresh();
        } catch (err) {
          toast(err.message || "Could not rename folder");
        }
      }

      async function renameFile(id) {
        const file = S.files.find((f) => f.id === id);
        if (!file) return toast("File not found");
        let name = ($("#mi")?.value || "").trim();
        if (!name) return toast("Enter a file name");
        const oldName = file.displayName || file.name || "";
        const lastDot = oldName.lastIndexOf(".");
        const extension = lastDot > 0 ? oldName.substring(lastDot) : "";
        if (
          extension &&
          !name.toLowerCase().endsWith(extension.toLowerCase())
        ) {
          name += extension;
        }
        try {
          await api("/file/" + encodeURIComponent(id), {
            method: "PATCH",
            body: JSON.stringify({
              operation: "rename",
              name,
            }),
          });
          closeModal();
          toast("File renamed successfully");
          await refresh();
        } catch (err) {
          toast(err.message || "Could not rename file");
        }
      }

